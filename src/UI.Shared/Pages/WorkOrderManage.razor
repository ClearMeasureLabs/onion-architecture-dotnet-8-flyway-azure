<div class="work-order-container">
    <div class="work-order-header">
        <h2>Work Order #@Model.WorkOrderNumber (@Model.Status)</h2>
    </div>

    <EditForm Model="@Model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <input type="hidden" @bind-value="Model.IsReadOnly" />
        <input type="hidden" @bind-value="Model.Status" />
        <input type="hidden" @bind-value="Model.CanReassign" />

        <div class="form-container">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Creator:</label>
                    <div>
                        <span class="value">@Model.CreatorFullName</span>
                        <input type="hidden" @bind-value="Model.CreatorUserName"/>
                    </div>
                </div>

                <div class="form-group">
                    <label for="AssignedToUserName" class="form-label">Assigned To:</label>
                    <div>
                        @if (!Model.IsReadOnly)
                        {
                            <InputSelect id="AssignedToUserName" @bind-Value="Model.AssignedToUserName" class="form-control input-select">
                                @foreach (var user in UserOptions)
                                {
                                    <option value="@user.Value">@user.Text</option>
                                }
                            </InputSelect>
                        }
                        else
                        {
                            <span class="value">@Model.WorkOrder?.Assignee?.GetFullName()</span>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label for="Title" class="form-label">Title:</label>
                    <div>
                        <InputText id="Title" @bind-Value="Model.Title" class="form-control input-text" disabled="@Model.IsReadOnly" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="Description" class="form-label">Description:</label>
                    <div>
                        <InputTextArea id="Description" @bind-Value="Model.Description" class="form-control input-textarea" disabled="@Model.IsReadOnly" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="RoomNumber" class="form-label">Room Number:</label>
                    <div>
                        <InputText id="RoomNumber" @bind-Value="Model.RoomNumber" class="form-control input-text" disabled="@Model.IsReadOnly" />
                    </div>
                </div>
            </div>

            <div class="readonly-info">
                <span class="label">Assigned Date:</span>
                <span class="value">@Model.AssignedDate</span>

                <span class="label">Completed Date:</span>
                <span class="value">@Model.CompletedDate</span>

                <span class="label">Created Date:</span>
                <span class="value">@Model.CreatedDate</span>
            </div>
        </div>

        @if (Model.WorkOrder != null && Model.WorkOrder.AuditEntries.Any())
        {
            <div class="audit-section">
                <h3>Audit History</h3>
                <table class="audit-table">
                    <thead>
                        <tr>
                            <th>Employee Name</th>
                            <th style="width:20%;">Date</th>
                            <th style="width:20%;">Begin Status</th>
                            <th style="width:20%;">End Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 0;
                            foreach (var auditEntry in Model.WorkOrder.AuditEntries)
                            {
                                var rowClass = (i++ % 2) == 0 ? "odd" : "even";
                                <tr class="@rowClass">
                                    <td>@auditEntry.ArchivedEmployeeName</td>
                                    <td>@auditEntry.Date</td>
                                    <td>@auditEntry.BeginStatus</td>
                                    <td>@auditEntry.EndStatus</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="action-section">
            @if (Model.IsReadOnly)
            {
                <div class="readonly-message">This work order is read-only for you at this time.</div>
            }
            else
            {
                <div class="action-buttons">
                    @foreach (IStateCommand command in ValidCommands)
                    {
                        <button type="submit" @onclick="@(() => SelectedCommand = command.TransitionVerbPresentTense)" class="btn btn-primary">
                            @command.TransitionVerbPresentTense
                        </button>
                    }
                </div>
            }
        </div>
    </EditForm>
</div>