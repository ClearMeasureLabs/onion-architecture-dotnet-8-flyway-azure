<h2>Search Results</h2>

<EditForm Model="@Model" OnValidSubmit="OnSearch!">
    <table class="search-filters">
        <thead>
        <tr>
            <th>Creator</th>
            <th>Assignee</th>
            <th>Status</th>
            <th>&nbsp;</th>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td>
                <InputSelect id="@WorkOrderSearch.Elements.CreatorSelect" @bind-Value="Model.Filters.Creator" class="form-control" style="width: 200px;">
                    <option value="">All</option>
                    @foreach (var user in UserOptions)
                    {
                        <option value="@user.Value">@user.Text</option>
                    }
                </InputSelect>
            </td>
            <td>
                <InputSelect id="@WorkOrderSearch.Elements.AssigneeSelect" @bind-Value="Model.Filters.Assignee" class="form-control" style="width: 200px;">
                    <option value="">All</option>
                    @foreach (var user in UserOptions)
                    {
                        <option value="@user.Value">@user.Text</option>
                    }
                </InputSelect>
            </td>
            <td>
                <InputSelect id="@WorkOrderSearch.Elements.StatusSelect" @bind-Value="Model.Filters.Status" class="form-control" style="width: 200px;">
                    <option value="">All</option>
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status.Value">@status.Text</option>
                    }
                </InputSelect>
            </td>
            <td>
                <button id="@WorkOrderSearch.Elements.SearchButton" type="submit" class="btn btn-primary">Search</button>
            </td>
        </tr>
        </tbody>
    </table>
</EditForm>

<br/>
<table class="grid-data">
    <thead>
    <tr>
        <th style="width:10%;">WO #</th>
        <th style="width:20%;">Creator</th>
        <th style="width:20%;">Assignee</th>
        <th style="width:15%;">Status</th>
        <th>Title</th>
    </tr>
    </thead>
    <tbody>
    @{
        var i = 0;
        foreach (var order in Model.Results)
        {
            var rowClass = i++ % 2 == 0 ? "odd" : "even";
            <tr class="@rowClass">
                <td>
                    <a href="/workorder/manage/@order.Number?mode=Edit">@order.Number</a>
                </td>
                <td>@order.Creator?.GetFullName()</td>
                <td>@order.Assignee?.GetFullName()</td>
                <td style="white-space: nowrap;">@order.Status</td>
                <td>@order.Title</td>
            </tr>
        }
    }
    </tbody>
</table>

@code {
    public enum Elements
    {
        CreatorSelect,
        AssigneeSelect,
        StatusSelect,
        SearchButton
    }

    public WorkOrderSearchModel Model { get; set; } = new();
    public List<SelectListItem> UserOptions { get; set; } = new();
    public List<SelectListItem> StatusOptions { get; set; } = new();
    public Func<Task>? OnSearch { get; set; }
}