@using System.Runtime.CompilerServices
@using System.Security.Principal
@using Palermo.BlazorMvc
@inherits Palermo.BlazorMvc.MvcLayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu/>
        <HealthCheckLink/>
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <Logout />
                </Authorized>
                <NotAuthorized>
                    <LoginLink/>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>